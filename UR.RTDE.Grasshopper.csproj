<Project Sdk="Microsoft.NET.Sdk">
	
  <PropertyGroup>
    <!-- Select the framework(s) you wish to target.
        Rhino 6: net45
        Rhino 7: net48
        Rhino 8 Windows: net48, net8.0, net8.0-windows, net8.0-windows10.0.22000.0, etc
        Rhino 8 Mac: net8.0, net8.0-macos, net8.0-macos12.0, etc
    -->
    <TargetFrameworks>net8.0-windows;net8.0;net48</TargetFrameworks>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <TargetExt Condition="'$(Configuration)' != 'Test'">.gha</TargetExt>
    <TargetExt Condition="'$(Configuration)' == 'Test'">.dll</TargetExt>
    <NoWarn>NU1701;NETSDK1086</NoWarn>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  
  <PropertyGroup>
    <!-- Specifies information for Assembly and Yak -->
    <Version>1.6.3.3</Version>
    <PackageId>UR.RTDE.Grasshopper</PackageId>
    <Title>UR.RTDE.Grasshopper</Title>
    <Company>UR.RTDE</Company>
    <Authors>lasaths</Authors>
    <Description>Grasshopper components to control Universal Robots via UR.RTDE (C# wrapper). Supports session management, reads (joints/pose/IO/modes), and basic commands.</Description>
    <PackageTags>Rhino;Rhino8;Grasshopper;Grasshopper8;Universal Robots;UR;UR5;UR10;UR20;RTDE;Robotics</PackageTags>
    <PackageProjectUrl>https://www.nuget.org/packages/UR.RTDE/</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Product>UR.RTDE.Grasshopper</Product>
    <!-- Build Yak package by default when Yak is available -->
    <BuildYakPackage Condition="'$(BuildYakPackage)' == ''">True</BuildYakPackage>
    <URRTDEVersion>1.6.3.9</URRTDEVersion>
    <URRTDELocalFeed Condition="'$(URRTDELocalFeed)' == '' and '$(Configuration)' == 'Debug' and Exists('$(MSBuildThisFileDirectory)../UR.RTDE/src/UR.RTDE/bin/Debug')">$(MSBuildThisFileDirectory)../UR.RTDE/src/UR.RTDE/bin/Debug</URRTDELocalFeed>
    <URRTDELocalFeed Condition="'$(URRTDELocalFeed)' == '' and Exists('$(MSBuildThisFileDirectory)../UR.RTDE/src/UR.RTDE/bin/Release')">$(MSBuildThisFileDirectory)../UR.RTDE/src/UR.RTDE/bin/Release</URRTDELocalFeed>
    <URRTDELocalFeed Condition="'$(URRTDELocalFeed)' == '' and Exists('/Users/lasaths/Documents/GitHub/UR.RTDE/src/UR.RTDE/bin/$(Configuration)')">/Users/lasaths/Documents/GitHub/UR.RTDE/src/UR.RTDE/bin/$(Configuration)</URRTDELocalFeed>
    <RestoreAdditionalProjectSources Condition="'$(URRTDELocalFeed)' != ''">$(RestoreAdditionalProjectSources);$(URRTDELocalFeed)</RestoreAdditionalProjectSources>
    <RestorePackagesPath Condition="'$(URRTDELocalFeed)' != '' and '$(RestorePackagesPath)' == ''">$(MSBuildThisFileDirectory).nuget/packages</RestorePackagesPath>
  </PropertyGroup>

  <!-- Allow test assembly to access internal members -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>UR.RTDE.Grasshopper.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Grasshopper" Version="8.0.23304.9001" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Compile includes are wildcarded; moving files into subfolders is automatically picked up -->
  <ItemGroup>
    <Compile Remove="UR.RTDE.Grasshopper.Tests\**" />
    <EmbeddedResource Remove="UR.RTDE.Grasshopper.Tests\**" />
    <None Remove="UR.RTDE.Grasshopper.Tests\**" />
  </ItemGroup>

  <!-- Embed any PNG icons placed under Resources/Icons -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\Icons\**\*.png" />
  </ItemGroup>

  <!-- Use UR.RTDE via NuGet only -->
  <ItemGroup>
    <PackageReference Include="UR.RTDE" Version="$(URRTDEVersion)" />
  </ItemGroup>

  <!-- Copy UR.RTDE.dll and native dependencies to output directory -->
  <Target Name="CopyURRTDEDependencies" AfterTargets="Build">
    <ItemGroup>
      <URRTDEFiles Include="$(NuGetPackageRoot)ur.rtde\$(URRTDEVersion)\lib\$(TargetFramework)\UR.RTDE.dll" />
      <URRTDENativeFiles Include="$(NuGetPackageRoot)ur.rtde\$(URRTDEVersion)\runtimes\**\*" />
    </ItemGroup>
    
    <Copy SourceFiles="@(URRTDEFiles)" DestinationFolder="$(OutputPath)" Condition="Exists('%(URRTDEFiles.Identity)')" />
    <Copy SourceFiles="@(URRTDENativeFiles)" DestinationFolder="$(OutputPath)\runtimes\%(RecursiveDir)" Condition="Exists('%(URRTDENativeFiles.Identity)')" />
    
    <!-- Copy native binaries beside the GHA (Windows: all DLLs; macOS: current single C ABI dylib) -->
    <ItemGroup>
      <NativeDLLs Include="$(OutputPath)\runtimes\win-x64\native\*.dll" />
      <!-- Prefer osx-arm64 to match Rhino 8 on Apple Silicon; only fallback to osx-x64 when arm64 is unavailable. -->
      <NativeMacLibs Include="$(OutputPath)\runtimes\osx-arm64\native\libur_rtde_c_api.dylib"
                     Condition="Exists('$(OutputPath)\runtimes\osx-arm64\native\libur_rtde_c_api.dylib')" />

      <NativeMacLibs Include="$(OutputPath)\runtimes\osx-x64\native\libur_rtde_c_api.dylib"
                     Condition="!Exists('$(OutputPath)\runtimes\osx-arm64\native\libur_rtde_c_api.dylib') and Exists('$(OutputPath)\runtimes\osx-x64\native\libur_rtde_c_api.dylib')" />
      <StaleMacNativeFiles Include="$(OutputPath)/librtde*.dylib;$(OutputPath)/libboost*.dylib;$(OutputPath)/runtimes/**/native/librtde*.dylib;$(OutputPath)/runtimes/**/native/libboost*.dylib" />
    </ItemGroup>
    <Delete Files="@(StaleMacNativeFiles)" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
    <Copy SourceFiles="@(NativeDLLs)" DestinationFolder="$(OutputPath)" Condition="Exists('%(NativeDLLs.Identity)')" />
    <Copy SourceFiles="@(NativeMacLibs)" DestinationFolder="$(OutputPath)" Condition="Exists('%(NativeMacLibs.Identity)')" />
    <ItemGroup>
      <MacDylibsToSign Include="$(OutputPath)*.dylib" />
      <MacDylibsToSign Include="$(OutputPath)runtimes/**/native/*.dylib" />
    </ItemGroup>
    <Exec Command="codesign --force --sign - &quot;%(MacDylibsToSign.Identity)&quot;" Condition="$([MSBuild]::IsOSPlatform('OSX')) and Exists('%(MacDylibsToSign.Identity)')" />
  </Target>

  <!-- Opt-in only: /p:CopyToGrasshopperLibraries=true (or CopyToGrasshopperLibrariesOnDebug=true for Debug on macOS) -->
  <Target Name="CopyToGrasshopperLibrariesMac" AfterTargets="CopyURRTDEDependencies" Condition="$([MSBuild]::IsOSPlatform('osx')) and ('$(CopyToGrasshopperLibraries)' == 'true' or ('$(Configuration)' == 'Debug' and '$(CopyToGrasshopperLibrariesOnDebug)' == 'true'))">
    <PropertyGroup>
      <GrasshopperMacLibraries>$(HOME)/Library/Application Support/McNeel/Rhinoceros/8.0/Plug-ins/Grasshopper (b45a29b1-4343-4035-989e-044e8580d9cf)/Libraries/UR.RTDE.Grasshopper</GrasshopperMacLibraries>
    </PropertyGroup>
    <MakeDir Directories="$(GrasshopperMacLibraries)" Condition="!Exists('$(GrasshopperMacLibraries)')" />
    <ItemGroup>
      <StaleGrasshopperMacNativeFiles Include="$(GrasshopperMacLibraries)/librtde*.dylib;$(GrasshopperMacLibraries)/libboost*.dylib;$(GrasshopperMacLibraries)/runtimes/**/native/librtde*.dylib;$(GrasshopperMacLibraries)/runtimes/**/native/libboost*.dylib" />
      <MacFilesToCopy Include="$(OutputPath)**\*.*" />
    </ItemGroup>
    <Delete Files="@(StaleGrasshopperMacNativeFiles)" />
    <Copy SourceFiles="@(MacFilesToCopy)" DestinationFiles="@(MacFilesToCopy->'$(GrasshopperMacLibraries)/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  
  <!-- For Windows only builds -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-windows')) or $(TargetFramework.StartsWith('net4'))">
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <!-- Reference WinForms for .NET 8.0 on macOS -->
  <ItemGroup Condition="!($(TargetFramework.Contains('-windows')) or $(TargetFramework.StartsWith('net4')))">
    <!-- Rhino 8.11 and later you can use this -->
    <!-- <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" /> -->
    
    <!-- Rhino 8.10 and earlier -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" ExcludeAssets="all" GeneratePathProperty="true" />
    <Reference Include="$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net48)\build\.NETFramework\v4.8\System.Windows.Forms.dll" Private="False" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Copy icon to net48 output for yak packaging -->
  <Target Name="CopyYakIcon" BeforeTargets="BuildYakPackage" Condition="$(BuildYakPackage) == 'True'">
    <PropertyGroup>
      <IconSource>$(MSBuildThisFileDirectory)Resources\Icons\robot-duotone.png</IconSource>
      <YakNet48Dir>$(MSBuildThisFileDirectory)bin\$(Configuration)\net48</YakNet48Dir>
      <IconDestination>$(YakNet48Dir)\robot-duotone.png</IconDestination>
    </PropertyGroup>
    <MakeDir Directories="$(YakNet48Dir)" Condition="!Exists('$(YakNet48Dir)')" />
    <Copy SourceFiles="$(IconSource)" DestinationFiles="$(IconDestination)" Condition="Exists('$(IconSource)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="EnsureYakTool" BeforeTargets="BuildYakPackage" Condition="$(BuildYakPackage) == 'True' and '$(YakExecutable)' == '' and $([MSBuild]::IsOSPlatform(macos)) and !Exists('$(MSBuildThisFileDirectory)tools/yak')">
    <Exec Command="bash &quot;$(MSBuildThisFileDirectory)tools/install-yak.sh&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" />
  </Target>

  <Target Name="BuildYakPackage" AfterTargets="DispatchToInnerBuilds" DependsOnTargets="EnsureYakTool">
    <PropertyGroup>
      <YakExecutable Condition="$(YakExecutable) == '' and $([MSBuild]::IsOSPlatform(windows)) and Exists('C:\Program Files\Rhino 8\System\Yak.exe')">C:\Program Files\Rhino 8\System\Yak.exe</YakExecutable>
      <YakExecutable Condition="$(YakExecutable) == '' and $([MSBuild]::IsOSPlatform(macos)) and '$(YakMacPath)' != '' and Exists('$(YakMacPath)')">$(YakMacPath)</YakExecutable>
      <YakExecutable Condition="$(YakExecutable) == '' and Exists('$(MSBuildThisFileDirectory)tools/yak')">$(MSBuildThisFileDirectory)tools/yak</YakExecutable>
      <YakOutputPath>$(MSBuildThisFileDirectory)bin/$(Configuration)/net48</YakOutputPath>
    </PropertyGroup>
    
    <Warning Text="Could not find Yak executable. On macOS without Rhino, run: bash tools/install-yak.sh" Condition="$(YakExecutable) == ''" />

    <ItemGroup>
      <YakPackagesToDelete Include="$(YakOutputPath)\*.yak;$(YakOutputPath)\**\manifest.yml" />
    </ItemGroup>
    
    <Delete Files="@(YakPackagesToDelete)" />

    <Exec Command="&quot;$(YakExecutable)&quot; spec" WorkingDirectory="$(YakOutputPath)" Condition="$(BuildYakPackage) == 'True' and '$(YakExecutable)' != '' and Exists($(YakExecutable)) and Exists($(YakOutputPath))" ContinueOnError="true" />
    <Exec Command="&quot;$(YakExecutable)&quot; build" WorkingDirectory="$(YakOutputPath)" Condition="$(BuildYakPackage) == 'True' and '$(YakExecutable)' != '' and Exists($(YakExecutable)) and Exists($(YakOutputPath))" ContinueOnError="true" />

  </Target>

  <!-- Generate duotone PNG icons at build time if not present -->
  <Target Name="GenerateDuotoneIcons" BeforeTargets="PrepareResources">
    <PropertyGroup>
      <IconScript>$(MSBuildThisFileDirectory)tools\generate-icons.ps1</IconScript>
      <DoIconGen Condition="Exists('$(IconScript)') and $([MSBuild]::IsOSPlatform(windows))">True</DoIconGen>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(IconScript)&quot;" Condition="$(DoIconGen) == 'True'" />
  </Target>

  <Target Name="CopyToGrasshopperLibraries" AfterTargets="CopyURRTDEDependencies" Condition="'$(Configuration)' != 'Test' and $([MSBuild]::IsOSPlatform('windows')) and '$(CopyToGrasshopperLibraries)' == 'true'">
  <PropertyGroup>
    <GrasshopperLibraryFolder>$(APPDATA)\Grasshopper\Libraries\UR.RTDE.Grasshopper</GrasshopperLibraryFolder>
    <GrasshopperFrameworkFolder>$(GrasshopperLibraryFolder)\$(TargetFramework)</GrasshopperFrameworkFolder>
  </PropertyGroup>
  
  <MakeDir Directories="$(GrasshopperLibraryFolder)" Condition="!Exists('$(GrasshopperLibraryFolder)')" />
  <RemoveDir Directories="$(GrasshopperFrameworkFolder)" Condition="'$(TargetFramework)' != '' and Exists('$(GrasshopperFrameworkFolder)')" />
  
  <ItemGroup>
    <FilesToCopy Include="$(OutputPath)**\*.*" />
  </ItemGroup>
  
  <Copy SourceFiles="@(FilesToCopy)" DestinationFiles="@(FilesToCopy->'$(GrasshopperLibraryFolder)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
</Target>

</Project>
