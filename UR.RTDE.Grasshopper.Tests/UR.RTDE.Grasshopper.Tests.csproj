<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <DisableImplicitFrameworkReferences>false</DisableImplicitFrameworkReferences>
    <URRTDEVersion>1.6.3</URRTDEVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="Rhino.Testing" Version="9.0.0-beta" />
    <PackageReference Include="UR.RTDE" Version="$(URRTDEVersion)" />
  </ItemGroup>
  
  <ItemGroup>
    <None Update="Rhino.Testing.Configs.xml" CopyToOutputDirectory="always" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UR.RTDE.Grasshopper.csproj" Private="true" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <Target Name="CopyURRTDENativeDependencies" AfterTargets="Build">
    <ItemGroup>
      <URRTDENativeFiles Include="$(NuGetPackageRoot)ur.rtde\$(URRTDEVersion)\runtimes\win-x64\native\*.dll" />
    </ItemGroup>

    <Copy SourceFiles="@(URRTDENativeFiles)" DestinationFolder="$(OutputPath)" Condition="Exists('%(URRTDENativeFiles.Identity)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
