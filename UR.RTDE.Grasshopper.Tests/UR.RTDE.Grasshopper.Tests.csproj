<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <DisableImplicitFrameworkReferences>false</DisableImplicitFrameworkReferences>
    <URRTDEVersion>1.6.3.10</URRTDEVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="Rhino.Testing" Version="9.0.0-beta" />
    <PackageReference Include="UR.RTDE" Version="$(URRTDEVersion)" />
  </ItemGroup>
  
  <ItemGroup>
    <None Update="Rhino.Testing.Configs.xml" CopyToOutputDirectory="always" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UR.RTDE.Grasshopper.csproj" Private="true" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <Target Name="CopyURRTDENativeDependencies" AfterTargets="Build">
    <ItemGroup>
      <URRTDEFiles Include="$(NuGetPackageRoot)ur.rtde\$(URRTDEVersion)\lib\$(TargetFramework)\UR.RTDE.dll" />
      <URRTDENativeFiles Include="$(NuGetPackageRoot)ur.rtde\$(URRTDEVersion)\runtimes\**\*" />
    </ItemGroup>

    <Copy SourceFiles="@(URRTDEFiles)" DestinationFolder="$(OutputPath)" Condition="Exists('%(URRTDEFiles.Identity)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(URRTDENativeFiles)" DestinationFolder="$(OutputPath)\runtimes\%(RecursiveDir)" Condition="Exists('%(URRTDENativeFiles.Identity)')" SkipUnchangedFiles="true" />

    <ItemGroup>
      <NativeDLLs Include="$(OutputPath)\runtimes\win-x64\native\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(NativeDLLs)" DestinationFolder="$(OutputPath)" Condition="Exists('%(NativeDLLs.Identity)')" SkipUnchangedFiles="true" />
    <ItemGroup>
      <MacDylibsToSign Include="$(OutputPath)*.dylib" />
      <MacDylibsToSign Include="$(OutputPath)runtimes/**/native/*.dylib" />
    </ItemGroup>
    <Exec Command="codesign --force --sign - &quot;%(MacDylibsToSign.Identity)&quot;" Condition="$([MSBuild]::IsOSPlatform('OSX')) and Exists('%(MacDylibsToSign.Identity)')" />
  </Target>

  <!-- NUnit loads UR.RTDE.Grasshopper.dll; the plugin project emits .gha -->
  <Target Name="CopyGhaAsDllForTests" AfterTargets="CopyURRTDENativeDependencies">
    <Copy SourceFiles="$(OutputPath)UR.RTDE.Grasshopper.gha"
          DestinationFiles="$(OutputPath)UR.RTDE.Grasshopper.dll"
          Condition="Exists('$(OutputPath)UR.RTDE.Grasshopper.gha')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
