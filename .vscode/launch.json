{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Rhino 8 Mac - Debug",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "debug-mac",
      "postDebugTask": "restore-grasshopper-libraries",
      "program": "${config:rhino.mac.app}/Contents/MacOS/Rhinoceros",
      "args": ["-runscript=_Grasshopper"],
      "env": {
        "RHINO_PACKAGE_DIRS": "${workspaceFolder}/bin/Debug/net8.0"
      },
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "internalConsole"
    },
    {
      "name": "Rhino 8 - netcore",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "",
      "osx": {
        "program": "${config:rhino.mac.app}/Contents/MacOS/Rhinoceros",
        "args": ["-runscript=_Grasshopper"]
      },
      "windows": {
        "program": "C:\\Program Files\\Rhino 8\\System\\Rhino.exe",
        "targetArchitecture": "x86_64",
        "args": "/netcore /runscript=\"_Grasshopper\""
      },
      "env": {
        "RHINO_PACKAGE_DIRS": "${workspaceFolder}/bin/Debug/net8.0"
      },
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "internalConsole"
    },
    {
      "name": "Rhino 8 Windows - netfx",
      "type": "clr",
      "request": "launch",
      "preLaunchTask": "build",
      "windows": {
        "program": "C:\\Program Files\\Rhino 8\\System\\Rhino.exe",
        "targetArchitecture": "x86_64",
        "args": "/netfx /runscript=\"_Grasshopper\""
      },
      "env": {
        "RHINO_PACKAGE_DIRS": "${workspaceFolder}/bin/Debug/net48${pathSeparator}${env:RHINO_PACKAGE_DIRS}"
      },
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "internalConsole"
    }
  ],
  "compounds": []
}
